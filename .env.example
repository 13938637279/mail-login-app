# wuchenyun.top —— 环境变量模板（复制为 .env 并填真实值；.env 不入 git）

# 站点
ADMIN_EMAIL=你的超管邮箱@qq.com
PORT=3000

# SMTP（发验证码邮件）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的QQ邮箱
SMTP_PASS=你的SMTP授权码
SMTP_FROM=你的QQ邮箱

# 拼多多多多进宝（pdd.ddk.goods.search 用）
PDD_CLIENT_ID=你的应用client_id
PDD_CLIENT_SECRET=你的应用client_secret
PDD_PID=你的推广位pid

# 可选：每用户监控上限
# MAX_MONITORS=50
